{
  "name": "aivee",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Waren Gonzaga",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/warengonzaga/ai-video-editing-engine.git"
  },
  "homepage": "https://github.com/warengonzaga/ai-video-editing-engine#readme",
  "bugs": {
    "url": "https://github.com/warengonzaga/ai-video-editing-engine/issues"
  },
  "type": "module",
  "bin": {
    "aivee": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/usage.md",
    "docs/releasing.md",
    "docs/aspect-ratio-presets.md",
    "CHANGELOG.md",
    "requirements-otio.txt"
  ],
  "description": "Local-first video editing CLI and JavaScript API for AI workflows.",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.9.17"
  },
  "overrides": {
    "hyperframes": {
      "undici": "7.30.2"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:render-smoke": "bun scripts/render-smoke.mjs",
    "doctor": "bun src/doctor.mjs",
    "new-video": "bun src/cli.mjs project create",
    "retime": "bun src/cli.mjs retime",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6"
  }
}

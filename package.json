{
  "name": "ai-video-editing-engine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "ai-video-engine": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE",
    "docs/architecture.md",
    "docs/usage.md",
    "docs/avatar-mouth-packs.md",
    "docs/aspect-ratio-presets.md",
    "docs/handoff.md",
    "docs/implementation-plan.md",
    "requirements-otio.txt"
  ],
  "description": "A local-first video editing engine with a versioned timeline, media tools, and render adapters.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.9.17"
  },
  "overrides": {
    "hyperframes": {
      "undici": "7.30.2"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:render-smoke": "node scripts/render-smoke.mjs",
    "doctor": "node src/doctor.mjs",
    "new-video": "node src/cli.mjs project create",
    "retime": "node src/cli.mjs retime"
  }
}
